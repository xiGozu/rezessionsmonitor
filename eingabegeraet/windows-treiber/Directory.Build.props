<Project>
  <!-- WDK/SDK aus NuGet (CI). Ist der WDK lokal installiert und fehlt packages\, greifen diese Imports nicht. -->
  <PropertyGroup>
    <DiyPkg>$(MSBuildThisFileDirectory)packages\</DiyPkg>
  </PropertyGroup>
  <Import Project="$(DiyPkg)Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('$(DiyPkg)Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(DiyPkg)Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('$(DiyPkg)Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="$(DiyPkg)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('$(DiyPkg)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
